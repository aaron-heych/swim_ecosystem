# ===== 服务 =====
PORT=3000
NODE_ENV=development

# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_DATABASE=swimming_platform
DB_SYNC=false
DB_LOGGING=false

# ===== JWT =====
JWT_SECRET=swim-ecosystem-jwt-secret-please-change
JWT_EXPIRES=7d

# ===== 微信小程序 =====
WX_APP_ID=
WX_APP_SECRET=

# ===== 微信公众号 =====
WX_OA_APP_ID=
WX_OA_APP_SECRET=

# ===== 加密 / 短信 =====
AES_SECRET=swim-ecosystem-aes-secret-key-32byte!!
SMS_SALT=swim-ecosystem-sms-salt
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=

# 关闭鉴权（仅本地联调用，true=跳过登录和权限校验，生产必须为 false）
AUTH_DISABLED=false
